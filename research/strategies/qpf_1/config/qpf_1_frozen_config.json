{
  "strategy_id": "QPF_1",
  "strategy_name": "Quality & Payout Factor",
  "version": "1.0.0",
  "hypothesis": "High-quality, durable companies with persistent multi-year profitability, conservative leverage, high cash-flow reliability, and sustainable shareholder distributions generate superior risk-adjusted returns over broad-market and quality indices across all market regimes.",
  "academic_reference": "IIM Ahmedabad (2022) Quality Factor Working Paper; Novy-Marx (2013); Asness et al. (2019)",
  "benchmark_reference": "Nifty500 Quality 50 TRI; Nifty 500 TRI",
  "universe": "NSE Cash Equities with >= 3 years audited annual filings and certified 1D price history",
  "factor_weights": {
    "profitability_5y_roe_stability": 0.35,
    "balance_sheet_leverage_bfsi_decoupled": 0.25,
    "cash_flow_reliability_cfo_pat": 0.25,
    "sustainable_shareholder_payout": 0.15
  },
  "portfolio_construction": {
