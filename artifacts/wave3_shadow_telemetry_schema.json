{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wave3ShadowTelemetryRecord",
  "description": "Standardized schema for read-only shadow evaluation telemetry records.",
  "type": "object",
  "required": [
    "timestamp",
    "scanner",
    "symbol",
    "cluster_id",
    "production_decision",
    "shadow_action",
    "shadow_rules_triggered",
    "shadow_position_size_multiplier",
    "shadow_sl_multiplier",
    "data_quality_status",
    "replay_eligibility",
    "dataset_version",
    "code_version",
    "feature_version"
  ],
  "properties": {
    "timestamp": { "type": "string" },
    "scanner": { "type": "string", "enum": ["EOD", "MULTI_TF", "REVERSAL", "ACCUMULATION"] },
    "symbol": { "type": "string" },
    "cluster_id": { "type": "string" },
    "production_decision": { "type": "string", "enum": ["PASS", "REJECTED", "ACTIVE_FILTER"] },
    "production_entry": { "type": ["number", "null"] },
    "production_sl": { "type": ["number", "null"] },
    "production_target": { "type": ["number", "null"] },
    "shadow_action": { "type": "string", "enum": ["PASS", "BLOCK", "SIZE_REDUCE_50", "TIGHTEN_SL_25"] },
    "shadow_rules_triggered": { "type": "array", "items": { "type": "string" } },
    "shadow_position_size_multiplier": { "type": "number" },
    "shadow_sl_multiplier": { "type": "number" },
    "shadow_entry": { "type": ["number", "null"] },
    "shadow_sl": { "type": ["number", "null"] },
    "shadow_target": { "type": ["number", "null"] },
    "sector_status": { "type": "string", "enum": ["TAILWIND", "NEUTRAL", "HEADWIND"] },
    "volume_ratio": { "type": "number" },
    "macro_state": { "type": "string" },
    "macro_drop_pct": { "type": "number" },
    "gross_trade_R": { "type": ["number", "null"] },
    "net_trade_R": { "type": ["number", "null"] },
    "portfolio_weighted_R": { "type": ["number", "null"] },
    "MFE_R": { "type": ["number", "null"] },
    "MAE_R": { "type": ["number", "null"] },
    "data_quality_status": { "type": "string", "enum": ["VALID", "SUSPECT", "CORRUPT"] },
    "replay_eligibility": { "type": "string", "enum": ["ELIGIBLE", "NOT_ELIGIBLE", "UNTESTABLE_WITH_CURRENT_DATA"] },
    "dataset_version": { "type": "string" },
    "code_version": { "type": "string" },
    "feature_version": { "type": "string" }
  }
}
